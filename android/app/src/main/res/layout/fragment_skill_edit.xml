<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/skillEditScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/colorOutline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/skillFormTitle"
                        style="@style/TextAppearance.SkillTracker.Subtitle"
                        android:text="@string/skill_edit_title" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/skillNameInputLayout"
                        style="@style/Widget.SkillTracker.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:hintTextAppearance="@style/TextAppearance.SkillTracker.Label">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/skillNameInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/skill_name_hint_required"
                            android:inputType="textCapSentences"
                            android:textColor="@color/colorOnSurface" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/skillDescriptionInputLayout"
                        style="@style/Widget.SkillTracker.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:hintTextAppearance="@style/TextAppearance.SkillTracker.Label">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/skillDescriptionInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:hint="@string/skill_description_hint"
                            android:inputType="textMultiLine"
                            android:maxLines="4"
                            android:minLines="3"
                            android:textColor="@color/colorOnSurface" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/skillCategoryInputLayout"
                        style="@style/Widget.SkillTracker.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:hintTextAppearance="@style/TextAppearance.SkillTracker.Label">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/skillCategoryInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/skill_category_hint"
                            android:inputType="textCapSentences"
                            android:textColor="@color/colorOnSurface" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/skillColorInputLayout"
                            style="@style/Widget.SkillTracker.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:hintTextAppearance="@style/TextAppearance.SkillTracker.Label">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/skillColorInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/skill_color_hint"
                                android:inputType="text"
                                android:textColor="@color/colorOnSurface" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <View
                            android:id="@+id/skillColorPreview"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_card"
                            android:backgroundTint="@color/colorSurfaceVariant"
                            android:contentDescription="@string/skill_color_hint" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/archiveSkillButton"
                            style="@style/Widget.SkillTracker.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/skill_archive_button" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/saveSkillButton"
                            style="@style/Widget.SkillTracker.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/save" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
