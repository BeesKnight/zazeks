<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:foregroundGravity="center"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="false"
    app:strokeColor="@color/colorOutline"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/skillColorIndicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:cardBackgroundColor="@color/colorOutline"
            app:cardCornerRadius="8dp"
            app:cardUseCompatPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/skillTitle"
            style="@style/TextAppearance.SkillTracker.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/skillColorIndicator"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/skillCategory"
            style="@style/TextAppearance.SkillTracker.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@color/colorSurfaceVariant"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textAllCaps="false"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/skillColorIndicator"
            app:layout_constraintTop_toBottomOf="@id/skillTitle" />

        <TextView
            android:id="@+id/skillDescription"
            style="@style/TextAppearance.SkillTracker.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:maxLines="3"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/skillColorIndicator"
            app:layout_constraintTop_toBottomOf="@id/skillCategory"
            app:layout_goneMarginTop="8dp" />

        <TextView
            android:id="@+id/skillArchivedLabel"
            style="@style/TextAppearance.SkillTracker.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:text="@string/skill_archived_label"
            android:textColor="@color/colorError"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/skillColorIndicator"
            app:layout_constraintTop_toBottomOf="@id/skillDescription"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
