<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/session_skill_label" />

        <Spinner
            android:id="@+id/sessionSkillSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/sessionDurationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/session_duration_hint"
            android:inputType="number"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/sessionDifficultyValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/session_difficulty_placeholder"
            android:layout_marginTop="12dp" />

        <SeekBar
            android:id="@+id/sessionDifficultySeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="4"
            android:progress="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/session_source_label"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/sessionSourceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/sessionNotesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/session_notes_hint"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/saveSessionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
