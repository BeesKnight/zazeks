<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/totalMinutesValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overview_total_minutes"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sessionsCountValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overview_sessions_count"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/skillsCountValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overview_skills_count"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/inactive_skills_title"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/inactiveSkillsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/statsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
